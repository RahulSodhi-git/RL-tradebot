# Optional Binance Futures TESTNET credentials.
# Do not put live keys here. Copy this file to .env and fill your own values.

BINANCE_FUTURES_TESTNET_KEY=
BINANCE_FUTURES_TESTNET_SECRET=

# Original legacy names are also supported:
BINANCE_API_KEY_FUT_TEST=
BINANCE_API_SECRET_FUT_TEST=
BINANCE_API_KEY_TEST=
BINANCE_API_SECRET_TEST=

# Keep model/data inspection on testnet unless you deliberately add live support later.
BINANCE_USE_TESTNET=true
USE_TESTNET=true
