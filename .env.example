# ---- Copy this file to ".env" and fill in your keys. NEVER share .env or commit it. ----

# LIVE keys (one key works for BOTH spot & futures on real Binance).
# Leave blank while testing on testnet.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# TESTNET keys (fake money).
# Unified demo (demo.binance.com): ONE key with all permissions = BOTH spot + futures.
# Just fill these two:
BINANCE_API_KEY_TEST=
BINANCE_API_SECRET_TEST=

# (Optional) Classic split testnets have SEPARATE keys per market. Leave blank unless you
# use them — if set, they OVERRIDE the unified key above for that market.
#   Spot testnet    -> https://testnet.binance.vision
#   Futures testnet -> https://testnet.binancefuture.com
BINANCE_API_KEY_SPOT_TEST=
BINANCE_API_SECRET_SPOT_TEST=
BINANCE_API_KEY_FUT_TEST=
BINANCE_API_SECRET_FUT_TEST=

# true = practice with fake money (testnet). false = REAL money. Start with true!
USE_TESTNET=true

# true = orders are only PRINTED, not sent (extra safety while learning).
DRY_RUN=false

# PIN that protects the Auto Bot page (Start/Stop trading). REQUIRED before using ngrok,
# or anyone with the link could trade your account. Pick any secret number/word.
BOT_UI_PIN=
